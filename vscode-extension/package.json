{
  "name": "workbuddy-agent",
  "displayName": "WorkBuddy Agent",
  "description": "Use your locally signed-in WorkBuddy / CodeBuddy account inside VS Code, via the local workbuddy-gateway.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:workbuddyAgent.chat"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "workbuddy",
        "displayName": "WorkBuddy"
      }
    ],
    "chatParticipants": [
      {
        "id": "workbuddyAgent.chat",
        "name": "workbuddy",
        "fullName": "WorkBuddy Agent",
        "description": "Ask your WorkBuddy account, with workspace tools",
        "isSticky": true,
        "commands": [
          {
            "name": "model",
            "description": "Show or set the model (e.g. /model hy4-preview-f)"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workbuddy-agent",
          "title": "WorkBuddy Agent",
          "icon": "$(hubot)"
        }
      ],
      "secondarySidebar": [
        {
          "id": "workbuddy-agent-secondary",
          "title": "WorkBuddy Agent",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "workbuddy-agent": [
        {
          "type": "webview",
          "id": "workbuddyAgent.chatView",
          "name": "Chat"
        }
      ],
      "workbuddy-agent-secondary": [
        {
          "type": "webview",
          "id": "workbuddyAgent.agentView",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "workbuddyAgent.open",
        "title": "WorkBuddy Agent: Open Chat"
      },
      {
        "command": "workbuddyAgent.openAgent",
        "title": "WorkBuddy Agent: Open Agent Panel (right side)"
      },
      {
        "command": "workbuddyAgent.newChat",
        "title": "WorkBuddy Agent: New Chat"
      },
      {
        "command": "workbuddyAgent.setGateway",
        "title": "WorkBuddy Agent: Set Gateway URL"
      },
      {
        "command": "workbuddyAgent.setApiKey",
        "title": "WorkBuddy Agent: Set API Key"
      },
      {
        "command": "workbuddyAgent.refreshModels",
        "title": "WorkBuddy Agent: Refresh Model List"
      },
      {
        "command": "workbuddyAgent.diagnose",
        "title": "WorkBuddy Agent: Diagnose Connection"
      },
      {
        "command": "workbuddyAgent.explainSelection",
        "title": "WorkBuddy Agent: Explain Selection",
        "enablement": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "WorkBuddy Agent",
      "properties": {
        "workbuddyAgent.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8790",
          "description": "Base URL of the local workbuddy-gateway (no trailing /v1)."
        },
        "workbuddyAgent.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key expected by the gateway. Leave empty if the gateway runs without one."
        },
        "workbuddyAgent.model": {
          "type": "string",
          "default": "hy4-preview-f",
          "description": "Default model id. hy4-preview-f is free; hy4-preview bills credits."
        },
        "workbuddyAgent.reasoningEffort": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "No reasoning: the field is not sent, so the model uses its default.",
            "Lightest reasoning",
            "Low reasoning",
            "Balanced reasoning",
            "Deep reasoning",
            "Deepest reasoning"
          ],
          "description": "Reasoning depth for models that have a thinking channel. Models without one ignore it."
        },
        "workbuddyAgent.maxToolSteps": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum tool calls per turn before the run stops. An exploratory task (search, read several files, edit, verify) commonly needs 20-40 steps; raise it for large refactors."
        },
        "workbuddyAgent.autoApproveFileWrites": {
          "type": "boolean",
          "default": false,
          "description": "Approve file writes without asking. Off by default: write tools confirm first."
        },
        "workbuddyAgent.autoApproveTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Approve terminal commands without asking. Off by default."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0"
  },
  "scripts": {
    "vscode:prepublish": "echo no-build-step"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zj12581/WorkBuddyToDeepSeekHarness.git"
  }
}